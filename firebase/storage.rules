rules_version = '2';
// MarchinZ 用 Cloud Storage for Firebase のルール例。
// 「Storage → ルール」にデプロイし、Firestore と同様に mll_privileged_uids で管理人を許可してください。
//
// アップロード先はアプリ側で mll_community/{ログインUID}/... としています。
// 管理人は isPrivileged() により、どの userId 配下にも書込・削除可能（モデレーション用）。

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isPrivileged() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/mll_privileged_uids/$(request.auth.uid));
    }

    match /mll_community/{userId}/{fileName} {
      allow read: if true;

      allow write: if signedIn()
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (request.auth.uid == userId || isPrivileged());

      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrivileged());
    }

    // レガシー誤パス（ml_community）— 古いクライアント資産向け。新規は mll_community を使用
    match /ml_community/{userId}/{fileName} {
      allow read: if true;

      allow write: if signedIn()
        && request.resource.size < 6 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (request.auth.uid == userId || isPrivileged());

      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrivileged());
    }

    // Log日記の写真（クライアントは mll_event_diary_media/{uid}/... にアップロード）
    match /mll_event_diary_media/{userId}/{fileName} {
      // 本人のみ。uid照合が無いと resource を参照しないルールになり、
      // Storage の list 操作まで許可される(listAll で他人の非公開写真を
      // 全列挙→getDownloadURL で取得できた)。2026-07-25 セキュリティレビュー。
      // 他人への公開は Firestore に保存済みのトークン付き downloadURL 経由のみ。
      allow read: if signedIn() && request.auth.uid == userId;

      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (request.auth.uid == userId || isPrivileged());

      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrivileged());
    }

    // MarchinZ Moment の写真（mll_moment_media/{uid}/...）
    match /mll_moment_media/{userId}/{fileName} {
      // 本人のみ。uid照合が無いと resource を参照しないルールになり、
      // Storage の list 操作まで許可される(listAll で他人の非公開写真を
      // 全列挙→getDownloadURL で取得できた)。2026-07-25 セキュリティレビュー。
      // 他人への公開は Firestore に保存済みのトークン付き downloadURL 経由のみ。
      allow read: if signedIn() && request.auth.uid == userId;

      allow write: if signedIn()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (request.auth.uid == userId || isPrivileged());

      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrivileged());
    }

    // プロフィールのアイコン・カバー（クライアントは avatar.jpg / cover.jpg のみ）
    match /mll_profile_media/{userId}/{fileName} {
      allow read: if true;

      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg.*')
        && fileName in ['avatar.jpg', 'cover.jpg'];

      allow delete: if signedIn()
        && (request.auth.uid == userId || isPrivileged());
    }

    // MarchinZ Base（練習ログ・楽器・ショウメモの写真）: 完全非公開・本人のみ read/write
    match /mll_base_media/{userId}/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;

      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
